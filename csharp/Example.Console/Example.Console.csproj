<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6</TargetFramework>
  </PropertyGroup>

  <ItemGroup Label="Build on Unix" Condition="'$(OS)' == 'Unix'">
    <PackageReference Include="DotNetBrowser.CrossPlatform" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup Label="Build on Windows" Condition="'$(OS)' != 'Unix'">
    <PackageReference Include="DotNetBrowser" Version="4.0.0" />
  </ItemGroup>

</Project>
